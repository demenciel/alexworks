{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alexworks",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "alexworks.app", "custom_domain": true },
    { "pattern": "www.alexworks.app", "custom_domain": true }
  ]
}
