---
import { products } from "../data/products";

const shipped = products.filter((product) => product.status === "live").length;
const lab = products.filter((product) => product.status === "building" || product.status === "validation").length;
const killed = products.filter((product) => product.status === "dead").length;
const currently = ["Shipping products", "Learning distribution", "Trying not to build too much"];

const stats = [
  { label: "Shipped", value: String(shipped).padStart(2, "0") },
  { label: "In the lab", value: String(lab).padStart(2, "0") },
  { label: "Killed", value: String(killed).padStart(2, "0") },
  { label: "Coffee", value: "too much" },
];
---

<section class="status" aria-labelledby="status-title">
  <div class="status-head">
    <h2 id="status-title">Currently</h2>
    <p class="online"><span class="pill-dot" aria-hidden="true"></span> online</p>
  </div>
  <ul class="now">
    {currently.map((item) => <li>{item}</li>)}
  </ul>
  <dl class="stats">
    {
      stats.map((stat) => (
        <div>
          <dt>{stat.label}</dt>
          <dd>{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
