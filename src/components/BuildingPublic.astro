---
import { site } from "../data/site";
---

<section class="building" id="building" aria-labelledby="building-title">
  <p class="kicker">04 — In public</p>
  <h2 id="building-title">Building out loud.</h2>
  <p class="building-copy">
    I share what I'm building, what works, what fails, and everything in between.
  </p>

  <article class="x-card">
    <div class="x-banner" aria-hidden="true"></div>
    <div class="x-body">
      <div class="x-top">
        <img class="x-photo" src={site.photo} alt="" width="96" height="96" />
        <a class="btn btn-primary x-follow" href={site.x} target="_blank" rel="noopener">
          Follow
          <span class="sr-only"> @{site.xHandle} on X, opens in a new tab</span>
        </a>
      </div>
      <p class="x-name">{site.person}</p>
      <p class="x-handle">@{site.xHandle}</p>
      <p class="x-bio">
        Small internet products. Shipping in public from somewhere in Canada.
      </p>
      <p class="x-note">ship → learn → repeat</p>
    </div>
  </article>
</section>
