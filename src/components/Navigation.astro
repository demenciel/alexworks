---
import Logo from "./Logo.astro";
import { site } from "../data/site";
---

<header class="nav-bar">
  <a class="nav-brand" href="/" aria-label="Alex Works, home">
    <Logo />
  </a>

  <div class="nav-rest">
    <p class="ship-badge">
      <span class="pill-dot" aria-hidden="true"></span>
      Shipping
    </p>

    <nav class="nav-links" aria-label="Primary">
      <a href="/#works">Products</a>
      <a href="/#about">About</a>
      <a class="icon-link" href={site.x} target="_blank" rel="noopener">
        <span class="sr-only">Alex on X</span>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
          <path
            fill="currentColor"
            d="M14.7 10.3 22.2 2h-1.8l-6.5 7.2L8.8 2H2.2l7.9 11.2L2 22h1.8l7-7.7L15.2 22h6.6l-8.1-11.7Zm-2.5 2.8-.8-1.1L4.6 3.3h2.8l5.2 7.2.8 1.1 6.8 9.5h-2.8l-5.6-7.9Z"
          ></path>
        </svg>
      </a>
      {
        site.github && (
          <a class="icon-link" href={site.github} target="_blank" rel="noopener">
            <span class="sr-only">GitHub</span>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.9 9.6.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5.1 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.4 9.4 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 4-2.3 4.8-4.6 5.1.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5 4-1.3 6.9-5.1 6.9-9.6C22 6.6 17.5 2 12 2Z"
              ></path>
            </svg>
          </a>
        )
      }
    </nav>

    <details class="nav-menu">
      <summary aria-label="Menu">
        <span class="burger" aria-hidden="true"></span>
      </summary>
      <div class="nav-panel">
        <a href="/#works">Products</a>
        <a href="/#about">About</a>
        <a href={site.x} target="_blank" rel="noopener">Follow @technoSaas</a>
        {site.github && <a href={site.github} target="_blank" rel="noopener">GitHub</a>}
      </div>
    </details>
  </div>
</header>
